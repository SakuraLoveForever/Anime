function openFolderModal(editId) {
  document.getElementById('folderModalOverlay').style.display = 'flex';
  if (editId) {
    const f = folderList.find(x => x.id === editId);
    if (!f) return;
    document.getElementById('folderModalTitle').textContent = '编辑收藏夹';
    document.getElementById('fName').value = f.name;
    document.getElementById('btnSaveFolder').textContent = '保存';
    document.getElementById('fName')._editId = editId;
  } else {
    document.getElementById('folderModalTitle').textContent = '新建收藏夹';
    document.getElementById('fName').value = '';
    document.getElementById('btnSaveFolder').textContent = '创建';
    document.getElementById('fName')._editId = null;
  }
  setTimeout(() => document.getElementById('fName').focus(), 100);
}

function closeFolderModal() {
  document.getElementById('folderModalOverlay').style.display = 'none';
}

function saveFolder() {
  const name = document.getElementById('fName').value.trim();
  if (!name) { showToast('请输入收藏夹名称'); return; }
  const editId = document.getElementById('fName')._editId;
  if (editId) {
    const f = folderList.find(x => x.id === editId);
    if (f) f.name = name;
  } else {
    folderList.push({ id: Date.now(), name, createdAt: new Date().toISOString() });
  }
  saveFolders();
  renderFolderList();
  closeFolderModal();
  showToast(editId ? '收藏夹已更新 ✓' : '收藏夹已创建 ✓');
}

function deleteFolder(id) {
  if (!confirm('确定删除此收藏夹？番剧不会被删除。')) return;
  animeList.forEach(a => { if (a.folderId === id) a.folderId = null; });
  folderList = folderList.filter(f => f.id !== id);
  saveData();
  saveFolders();
  renderCards();
  renderFolderList();
}

function moveToFolder(animeId, folderId) {
  const a = animeList.find(x => x.id === animeId);
  if (!a) return;
  a.folderId = folderId || null;
  saveData();
  renderCards();
  renderFolderList();
  showToast(folderId ? '已移入收藏夹 ✓' : '已移出收藏夹 ✓');
}

function populateFolderDropdown() {
  const sel = document.getElementById('mFolder');
  if (!sel) return;
  sel.innerHTML = '<option value="">无</option>' + folderList.map(f =>
    `<option value="${f.id}">${escapeHtml(f.name)}</option>`
  ).join('');
}

function escapeHtml(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }

// ===== Keyboard =====
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (selectionMode) { toggleSelectionMode(); return; }
    var visible = function(id) { var el = document.getElementById(id); return el && el.style.display !== 'none'; };
    if (visible('settingsModalOverlay')) closeSettingsModal();
    else if (visible('sourceModalOverlay')) closeAddSourceModal();
    else if (visible('batchSourceModalOverlay')) closeBatchSourceModal();
    else if (visible('folderModalOverlay')) closeFolderModal();
    else if (visible('sourceManagerOverlay')) closeSourceManager();
    else if (visible('deleteConfirmOverlay')) closeDeleteConfirm();
    else if (visible('modalOverlay')) closeModal();
    else if (visible('batchAddOverlay')) closeBatchAddModal();
    else if (visible('detailOverlay')) closeDetailPopup();
  }
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); document.getElementById('searchInput').focus(); }
});

// ===== Theme System =====
const THEMES = [
  { id: 'anime',   name: 'Anime',   icon: '🌌', desc: '二次元星云暗色（默认）' },
  { id: 'spotify', name: 'Spotify', icon: '●', desc: '沉浸式近黑播放器 — DESIGN_spotify.md' },
  { id: 'apple',   name: 'Apple',   icon: '◈', desc: '摄影画廊白昼 — DESIGN_apple.md' },
  { id: 'claude',  name: 'Claude',  icon: '◆', desc: '温暖编辑奶油 — DESIGN_claude.md' },
  { id: 'linear',  name: 'Linear',  icon: '▣', desc: '暗黑产品面板 — DESIGN_linear.md' },
  { id: 'lovable', name: 'Lovable', icon: '◇', desc: '羊皮纸暖灰 — DESIGN_loveable.md' },
  { id: 'tesla',   name: 'Tesla',   icon: '○', desc: '极简纯白展厅 — DESIGN_tesla.md' },
];
let currentTheme = localStorage.getItem('app-theme') || 'anime';

function applyTheme(id) {
  currentTheme = id;
  document.documentElement.setAttribute('data-theme', id);
  localStorage.setItem('app-theme', id);
  updateThemeButton();
}

function cycleTheme() {
  const idx = THEMES.findIndex(t => t.id === currentTheme);
  const next = THEMES[(idx + 1) % THEMES.length];
  applyTheme(next.id);
  showToast(`主题切换：${next.icon} ${next.name} — ${next.desc}`);
  renderThemePopover();
}

function toggleThemePopover() {
  const popover = document.getElementById('themePopover');
  const backdrop = document.getElementById('themePopoverBackdrop');
  if (popover.classList.contains('show')) {
    closeThemePopover();
    return;
  }
  renderThemePopover();
  popover.classList.add('show');
  backdrop.classList.add('show');
  const btn = document.getElementById('btnTheme');
  if (btn) {
    const rect = btn.getBoundingClientRect();
    popover.style.top = (rect.bottom + 8) + 'px';
    popover.style.right = (window.innerWidth - rect.right) + 'px';
  }
}

function closeThemePopover() {
  document.getElementById('themePopover').classList.remove('show');
  document.getElementById('themePopoverBackdrop').classList.remove('show');
}

function renderThemePopover() {
  const popover = document.getElementById('themePopover');
  popover.innerHTML = THEMES.map(t => `
    <button class="theme-option${t.id === currentTheme ? ' active' : ''}" onclick="setTheme('${t.id}');renderThemePopover();">
      <span class="theme-option-icon">${t.icon}</span>
      <span class="theme-option-info">
        <div class="theme-option-name">${t.name}</div>
        <div class="theme-option-desc">${t.desc}</div>
      </span>
      <span class="theme-option-check">✓</span>
    </button>
  `).join('');
}

function setTheme(id) {
  if (id === currentTheme) { closeThemePopover(); return; }
  applyTheme(id);
  renderThemePopover();
  const t = THEMES.find(x => x.id === id);
  if (t) showToast(`主题切换：${t.icon} ${t.name} — ${t.desc}`);
  closeThemePopover();
}

function updateThemeButton() {
  const btn = document.getElementById('btnTheme');
  const t = THEMES.find(x => x.id === currentTheme);
  if (btn && t) btn.title = `当前主题：${t.name} — ${t.desc}（点击切换）`;
}

// ===== Settings =====
const apiKeyConfigured = !!localStorage.getItem('anime_api_key');

function openSettingsModal() {
  document.getElementById('settingsApiProvider').value = localStorage.getItem('anime_api_provider') || 'deepseek';
  document.getElementById('settingsApiUrl').value = localStorage.getItem('anime_api_url') || 'https://api.deepseek.com';
  document.getElementById('settingsApiKey').value = localStorage.getItem('anime_api_key') || '';
  document.getElementById('settingsModalOverlay').style.display = 'flex';
}

function closeSettingsModal() {
  document.getElementById('settingsModalOverlay').style.display = 'none';
}

function updateSettingsApiUrl() {
  const provider = document.getElementById('settingsApiProvider').value;
  const urlInput = document.getElementById('settingsApiUrl');
  if (provider === 'deepseek') urlInput.value = 'https://api.deepseek.com';
}

function toggleApiKeyVisibility() {
  const input = document.getElementById('settingsApiKey');
  input.type = input.type === 'password' ? 'text' : 'password';
}

async function testAiApi() {
  var key = document.getElementById('settingsApiKey').value.trim();
  if (!key) { showToast('请先输入 API Key'); return; }
  var resultDiv = document.getElementById('aiTestResult');
  resultDiv.style.display = 'block';
  resultDiv.style.color = 'var(--color-base-content)';
  resultDiv.style.opacity = '0.7';
  resultDiv.textContent = '正在测试 DeepSeek API...';
  try {
    // Save key temporarily so server can use it
    var resp = await fetch('/api/config', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ deepseekApiKey: key })
    });
    if (!resp.ok) { throw new Error('保存 Key 失败'); }
    // Test the AI API
    var testResp = await fetch('/api/test-ai', { method: 'POST' });
    if (testResp.ok) {
      var data = await testResp.json();
      resultDiv.style.color = 'var(--color-success)';
      resultDiv.style.opacity = '1';
      resultDiv.innerHTML = '✓ API 连接成功！模型：' + (data.model || 'deepseek-chat');
    } else {
      var err = await testResp.json().catch(function() { return { error: 'HTTP ' + testResp.status }; });
      resultDiv.style.color = 'var(--color-error)';
      resultDiv.style.opacity = '1';
      resultDiv.textContent = '✗ API 测试失败：' + (err.error || '未知错误');
    }
  } catch(e) {
    resultDiv.style.color = 'var(--color-error)';
    resultDiv.style.opacity = '1';
    resultDiv.textContent = '✗ 错误：' + e.message;
  }
}

async function saveSettings() {
  const provider = document.getElementById('settingsApiProvider').value;
  const url = document.getElementById('settingsApiUrl').value.trim();
  const key = document.getElementById('settingsApiKey').value.trim();
  localStorage.setItem('anime_api_provider', provider);
  localStorage.setItem('anime_api_url', url);
  localStorage.setItem('anime_api_key', key);
  // Also save to server config.json so backend can use it
  if (key && backendOnline) {
    try {
      await fetch('/api/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deepseekApiKey: key })
      });
    } catch(e) {}
  }
  closeSettingsModal();
  showToast('设置已保存 ✓');
}

let _undoAction = null;

// ===== Undo =====
function pushUndo(action) {
  _undoAction = action;
}

function undoLastAction() {
  if (!_undoAction) { showToast('没有可撤销的操作'); return; }
  var a = _undoAction;
  _undoAction = null;
  if (a.type === 'add' && a.ids) {
    for (var i = 0; i < a.ids.length; i++) {
      animeList = animeList.filter(function(x) { return x.id !== a.ids[i]; });
    }
    saveData(); renderCards();
    showToast('已撤销添加 ' + a.ids.length + ' 部番剧 ✓');
  } else if (a.type === 'delete' && a.items) {
    for (var i = 0; i < a.items.length; i++) {
      animeList.push(a.items[i]);
    }
    saveData(); renderCards();
    showToast('已撤销删除 ' + a.items.length + ' 部番剧 ✓');
  } else if (a.type === 'edit' && a.id && a.before) {
    var target = animeList.find(function(x) { return x.id === a.id; });
    if (target) {
      Object.assign(target, a.before);
      saveData(); renderCards();
      showToast('已撤销编辑 ✓');
    }
  } else {
    showToast('无法撤销该操作');
  }
}

// ===== Toast =====
function showToast(msg, undoAction) {
  var container = document.getElementById('toastContainer');
  var toast = document.createElement('div');
  toast.className = 'toast';
  if (undoAction) {
    pushUndo(undoAction);
    toast.innerHTML = '<span>' + msg + '</span><button class="toast-undo" onclick="undoLastAction();this.closest(\'.toast\').remove()">撤销</button>';
  } else {
    _undoAction = null;
    toast.textContent = msg;
  }
  container.appendChild(toast);
  setTimeout(function() { if (toast.parentElement) toast.remove(); }, 4000);
}

// ===== File Protocol Warning =====
(function() {
  if (window.location.protocol === 'file:') {
    const banner = document.createElement('div');
    banner.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;background:color-mix(in srgb, var(--color-error) 92%, transparent);color:var(--color-error-content);text-align:center;padding:10px 16px;font-size:0.85rem;font-weight:600;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);';
    banner.innerHTML = '⚠ 检测到通过 file:// 协议打开，番剧数据无法与 localhost:3456 共享。请使用 <code style="background:rgba(255,255,255,0.2);padding:2px 8px;border-radius:4px;">start.bat</code> 启动以读取已保存的数据。 <button onclick="this.parentElement.remove()" style="margin-left:12px;background:rgba(255,255,255,0.2);border:none;color:var(--color-error-content);padding:4px 12px;border-radius:4px;cursor:pointer;font-size:0.8rem;">✕ 关闭</button>';
    document.body.prepend(banner);
  }
})();

// ===== Init =====
loadData();
loadFolders();
loadSearchHistory();
applyTheme(currentTheme);
checkBackend().then(async () => {
  if (!backendOnline) await loadSourceList();
  renderFolderList();
  renderCards();
});
</script>
