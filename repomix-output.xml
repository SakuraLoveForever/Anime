  document.getElementById('cardGrid').classList.remove('selection-mode');
  document.getElementById('btnSelectMode').classList.remove('active');
  updateBatchBar();
  saveData();
  renderCards();
  renderFolderList();
  showToast('已批量删除 ✓');
}

let detailPopupCard = null, detailPopupScrollHandler = null;
let detailPopupCloseHandler = null;

function openDetailPopup(id, anchorRect) {
  detailPopupId = id;
  renderDetailPopup(id);
  const overlay = document.getElementById('detailOverlay');
  overlay.style.display = 'block';
  document.getElementById('detailPopup').style.display = '';
  const card = document.querySelector(`.anime-card[data-aid="${id}"]`);
  detailPopupCard = card || null;
  if (detailPopupCard) {
    detailPopupCard._prevZIndex = detailPopupCard.style.zIndex;
    detailPopupCard.style.zIndex = '152';
    detailPopupCard.style.position = 'relative';
  }
  positionDetailPopup(anchorRect);
  if (detailPopupScrollHandler) {
    window.removeEventListener('scroll', detailPopupScrollHandler, { capture: true, passive: true });
  }
  detailPopupScrollHandler = () => {
    if (detailPopupCard) {
      const r = detailPopupCard.getBoundingClientRect();
      positionDetailPopup(r);
    }
  };
  window.addEventListener('scroll', detailPopupScrollHandler, { capture: true, passive: true });
  var scrollW = window.innerWidth - document.documentElement.clientWidth;
  document.body.style.paddingRight = scrollW + 'px';
  document.body.style.overflow = 'hidden';
  if (detailPopupCloseHandler) document.removeEventListener('click', detailPopupCloseHandler);
  detailPopupCloseHandler = (e) => {
    const popup = document.getElementById('detailPopup');
    if (popup && !popup.contains(e.target) && !e.target.closest('.anime-card')) {
      closeDetailPopup();
    }
  };
  setTimeout(() => document.addEventListener('click', detailPopupCloseHandler), 0);
}

function positionDetailPopup(anchorRect) {
  const popup = document.getElementById('detailPopup');
  const popupW = 360;
  const popupMaxH = Math.min(420, window.innerHeight - 24);
  const gap = 8;
  if (anchorRect) {
    let left = anchorRect.right + gap;
    if (left + popupW > window.innerWidth - 12) left = anchorRect.left - popupW - gap;
    left = Math.max(12, Math.min(left, window.innerWidth - popupW - 12));
    let top = anchorRect.top;
    const popupH = Math.min(popupMaxH, popup.scrollHeight || 400);
    if (top + popupH > window.innerHeight - 12) {
      top = Math.max(12, window.innerHeight - popupH - 12);
    }
    if (top < 12) top = 12;
    popup.style.position = 'fixed';
    popup.style.left = left + 'px';
    popup.style.top = top + 'px';
    popup.style.transform = '';
    popup.style.maxHeight = popupMaxH + 'px';
  } else {
    popup.style.position = 'absolute';
    popup.style.left = '50%';
    popup.style.top = '50%';
    popup.style.transform = 'translate(-50%, -50%)';
    popup.style.maxHeight = '70vh';
  }
}

function closeDetailPopup(e) {
  detailPopupId = null;
  if (detailPopupCard) {
    detailPopupCard.style.zIndex = detailPopupCard._prevZIndex || '';
    detailPopupCard.style.position = '';
    detailPopupCard._prevZIndex = null;
  }
  detailPopupCard = null;
  if (detailPopupScrollHandler) {
    window.removeEventListener('scroll', detailPopupScrollHandler, { capture: true, passive: true });
    detailPopupScrollHandler = null;
  }
  if (detailPopupCloseHandler) {
    document.removeEventListener('click', detailPopupCloseHandler);
    detailPopupCloseHandler = null;
  }
  document.body.style.overflow = '';
  document.body.style.paddingRight = '';
  document.getElementById('detailOverlay').style.display = 'none';
  const popup = document.getElementById('detailPopup');
  popup.style.display = 'none';
  popup.style.position = '';
  popup.style.transform = '';
  popup.style.left = '';
  popup.style.top = '';
  popup.style.maxHeight = '';
}

function renderDetailPopup(id) {
  const a = animeList.find(x => x.id === id);
  if (!a) { closeDetailPopup(); return; }
  const wc = a.watchedEpisodes ? a.watchedEpisodes.length : 0;
  const total = a.totalEpisodes || 12;
  const st = { towatch: '待看', watching: '正在看', watched: '已看完' };
  let epsHTML = '';
  for (let i = 1; i <= total; i++) {
    const w = a.watchedEpisodes && a.watchedEpisodes.includes(i);
    epsHTML += `<div class="episode-block${w ? ' watched' : ''}" onclick="toggleEpisode(${a.id},${i})" title="第${i}集">${i}</div>`;
  }
  document.getElementById('detailPopup').innerHTML = `
    <div class="detail-popup-header">
      <div class="detail-popup-title">${escapeHtml(a.title)}</div>
      <button class="detail-popup-close" onclick="closeDetailPopup()">✕</button>
    </div>
    <div class="detail-popup-meta">
      <span class="card-status-badge ${a.status}" style="position:static;display:inline-block">${st[a.status]}</span>
      <span>${wc}/${total} 集</span>
      ${a.score ? `<span>★ ${a.score.toFixed(1)}</span>` : ''}
    </div>
    <div class="detail-popup-section">
      <div class="detail-popup-section-title">剧集进度 · 点击切换</div>
      <div class="episode-grid">${epsHTML}</div>
      <div class="episode-actions">
        <button class="episode-action-btn" onclick="markAllEpisodes(${a.id})">✓ 全部已看</button>
        <button class="episode-action-btn" onclick="resetEpisodes(${a.id})">↺ 重置进度</button>
      </div>
    </div>
  `;
}

// ===== Episodes =====
function toggleEpisode(animeId, epNum) {
  const a = animeList.find(x => x.id === animeId); if (!a) return;
  if (!a.watchedEpisodes) a.watchedEpisodes = [];
  const idx = a.watchedEpisodes.indexOf(epNum);
  if (idx >= 0) a.watchedEpisodes.splice(idx, 1);
  else { a.watchedEpisodes.push(epNum); a.watchedEpisodes.sort((x,y)=>x-y); }
  const total = a.totalEpisodes || 12, wc = a.watchedEpisodes.length;
  if (wc === 0) a.status = 'towatch'; else if (wc >= total) a.status = 'watched'; else a.status = 'watching';
  saveData(); detailPopupId = animeId; renderCards();
}
function markAllEpisodes(id) {
  const a = animeList.find(x => x.id === id); if (!a) return;
  a.watchedEpisodes = Array.from({length: a.totalEpisodes||12}, (_,i)=>i+1); a.status = 'watched';
  saveData(); detailPopupId = id; renderCards();
}
function resetEpisodes(id) {
  if (!confirm('确定要重置这部番剧的观看进度吗？所有已看集数将被清空，状态将变为"待看"。')) return;
  const a = animeList.find(x => x.id === id); if (!a) return;
  a.watchedEpisodes = []; a.status = 'towatch';
  saveData(); detailPopupId = id; renderCards();
}

// ===== AI Batch Fill =====
async function batchAiFillAll() {
  if (!backendOnline) { showToast('后端未连接'); return; }
  if (!apiKeyConfigured) { showToast('请先在设置中配置 DeepSeek API Key'); return; }
  const all = animeList.filter(a => a && a.title);
  if (all.length === 0) { showToast('还没有添加任何番剧'); return; }
  if (!confirm(`即将对全部 ${all.length} 部番剧进行 AI 信息补全，过程中请勿关闭页面。\n\n已有信息不会被覆盖，仅补充缺失字段（简介、集数、分类、评分、标签、封面）。\n\n是否继续？`)) return;
  const btn = document.getElementById('btnBatchAi');
  const origText = btn.textContent;
  btn.disabled = true;
  let done = 0;
  for (const a of all) {
    btn.textContent = `⏳ 补全中 ${done+1}/${all.length}...`;
    let updated = false;
    try {
      const resp = await aiEnrich(a.title);
      const data = (resp && resp.data) ? resp.data : resp;
      if (data) {
        if (data.synopsis && data.synopsis.trim()) { a.synopsis = data.synopsis; updated = true; }
        if (data.episodes > 0 && !a.totalEpisodes) { a.totalEpisodes = data.episodes; updated = true; }
        if (data.category && data.category.trim() && !a.category) { a.category = normalizeCategory(data.category); updated = true; }
        if (data.genres && data.genres.length > 0 && (!a.genres || a.genres.length === 0)) { a.genres = data.genres; updated = true; }
        if (data.score && !a.score) { a.score = typeof data.score === 'number' ? data.score : parseFloat(data.score) || null; updated = true; }
        if (!a.cover && data.cover) { a.cover = data.cover; updated = true; }
      }
    } catch(e) {}
    done++;
    if (updated) {
      saveData();
      renderCards();
      if (detailPopupId === a.id) renderDetailPopup(a.id);
      await new Promise(r => setTimeout(r, 100));
    }
    if (done < all.length) await new Promise(r => setTimeout(r, 800));
  }
  saveData();
  renderCards();
  btn.textContent = origText;
  btn.disabled = false;
  showToast(`AI补全完成！已处理 ${done} 部番剧 ✓`);
}

// ===== Reclassify All =====
async function reclassifyAll() {
  if (!backendOnline) { showToast('后端未连接'); return; }
  if (!apiKeyConfigured) { showToast('请先在设置中配置 DeepSeek API Key'); return; }
  var all = animeList.filter(function(a) { return a && a.title; });
  if (all.length === 0) { showToast('还没有添加任何番剧'); return; }
  if (!confirm(`即将对全部 ${all.length} 部番剧使用 AI 重新分类（基于分类标准文档）。\n\n原有分类将被覆盖，是否继续？`)) return;
  var btn = document.getElementById('btnReclassify');
  var origText = btn.textContent;
  btn.disabled = true;

  // Send in batches of 15 to keep prompt manageable
  var batchSize = 15;
  var changed = 0;
  for (var offset = 0; offset < all.length; offset += batchSize) {
    var batch = all.slice(offset, offset + batchSize);
    btn.textContent = `🔄 分类中 ${offset + 1}-${Math.min(offset + batchSize, all.length)}/${all.length}...`;
    try {
      var resp = await fetch('/api/reclassify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titles: batch.map(function(a) { return a.title; }) }),
        signal: AbortSignal.timeout(35000),
      });
      var json = await resp.json();
      if (json.results && json.results.length > 0) {
        for (var i = 0; i < json.results.length; i++) {
          var r = json.results[i];
          var target = batch.find(function(a) { return a.title === r.title; });
          if (target && r.category && target.category !== r.category) {
            target.category = r.category;
            changed++;
          }
        }
        if (json.results.length > 0) {
          saveData();
          renderCards();
        }
      }
    } catch(e) {}
    if (offset + batchSize < all.length) await new Promise(function(r) { return setTimeout(r, 600); });
  }
  btn.textContent = origText;
  btn.disabled = false;
  if (changed > 0) {
    showToast(`重新分类完成！已更新 ${changed} 部番剧的分类 ✓`, { type: 'reclassify', changed: changed });
  } else {
    showToast('所有番剧分类已是最新，无需更新 ✓');
  }
}

async function aiFillCard(id) {
  if (!backendOnline) { showToast('后端未连接'); return; }
  if (!apiKeyConfigured) { showToast('请先在设置中配置 DeepSeek API Key'); return; }
  const a = animeList.find(x => x.id === id);
  if (!a || !a.title) return;
  showToast('⏳ 正在AI补全...');
  try {
    const resp = await aiEnrich(a.title);
    const data = (resp && resp.data) ? resp.data : resp;
    if (data && data.title) {
      if (data.synopsis && data.synopsis.trim()) a.synopsis = data.synopsis;
      if (data.genres && data.genres.length > 0 && (!a.genres || a.genres.length === 0)) a.genres = data.genres;
      if (data.episodes > 0 && !a.totalEpisodes) a.totalEpisodes = data.episodes;
      if (data.category && data.category.trim() && !a.category) a.category = normalizeCategory(data.category);
      if (!a.cover && data.cover) a.cover = data.cover;
      if (data.score && !a.score) a.score = typeof data.score === 'number' ? data.score : parseFloat(data.score) || null;
      saveData();
      renderCards();
      if (detailPopupId === id) renderDetailPopup(id);
      showToast('AI补全完成 ✓');
    } else { showToast('AI未找到匹配结果'); }
  } catch(e) { showToast('AI补全失败：' + e.message); }
}

