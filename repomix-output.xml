function batchAddAnime() {
  var raw = document.getElementById('batchAddNames').value.trim();
  if (!raw) { showToast('请输入至少一个番剧名称'); return; }
  var names = raw.split(/[\n,]+/).map(function(s) { return s.trim(); }).filter(Boolean);
  if (names.length === 0) { showToast('请输入至少一个番剧名称'); return; }
  var category = normalizeCategory(document.getElementById('batchAddOverlay')._category);
  var status = document.getElementById('batchAddOverlay')._status || 'towatch';
  var added = 0;
  var newIds = [];
  for (var i = 0; i < names.length; i++) {
    var title = names[i];
    if (!title) continue;
    if (animeList.some(function(a) { return a.title === title; })) continue;
    var nid = Date.now() + i;
    newIds.push(nid);
    var we = status === 'watched' ? Array.from({length: 12}, function(_,j) { return j+1; }) : [];
    animeList.push({
      id: nid,
      title: title,
      status: status,
      totalEpisodes: 12,
      watchedEpisodes: we,
      score: null,
      cover: null,
      synopsis: '',
      genres: [],
      category: category,
      folderId: null,
      sourceUrl: '',
      addedAt: new Date().toISOString()
    });
    added++;
  }
  if (added > 0) {
    saveData();
    renderCards();
    showToast('已批量添加 ' + added + ' 部番剧 ✓', { type: 'add', ids: newIds });
  } else {
    showToast('没有新番剧被添加（可能已存在）');
  }
  closeBatchAddModal();
}

