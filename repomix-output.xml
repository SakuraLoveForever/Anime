  .sidebar-source-item:hover .src-del { opacity: 0.7; }
  .src-del:hover { opacity: 1 !important; background: color-mix(in srgb, var(--color-error) 15%, transparent); }
  .src-add-btn {
    width: 100%; padding: 8px; margin-top: 4px; border: 1px dashed color-mix(in srgb, var(--color-primary) 20%, transparent);
    background: transparent; color: var(--color-primary); cursor: pointer;
