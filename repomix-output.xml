// ===== Batch Selection =====
function toggleSelectionMode() {
  selectionMode = !selectionMode;
  if (!selectionMode) {
    selectedIds.clear();
    updateBatchBar();
    document.querySelectorAll('.anime-card.selected').forEach(el => el.classList.remove('selected'));
  }
  document.getElementById('cardGrid').classList.toggle('selection-mode', selectionMode);
  document.getElementById('btnSelectMode').classList.toggle('active', selectionMode);
}

function updateBatchBar() {
  const bar = document.getElementById('batchBar');
  const show = selectionMode && selectedIds.size > 0;
  bar.style.display = show ? 'flex' : 'none';
  document.getElementById('batchCount').textContent = `已选 ${selectedIds.size} 项`;
  const folderSel = document.getElementById('batchMoveFolder');
  folderSel.innerHTML = '<option value="">移至收藏夹…</option>' +
    folderList.map(f => `<option value="${f.id}">${escapeHtml(f.name)}</option>`).join('');
}

function toggleCardSelect(aid) {
  if (!selectionMode) return;
  if (selectedIds.has(aid)) selectedIds.delete(aid);
  else selectedIds.add(aid);
  updateBatchBar();
  const card = document.getElementById('card-' + aid);
  if (card) card.classList.toggle('selected', selectedIds.has(aid));
}

function selectAllCards() {
  const list = getFilteredList();
  list.forEach(a => selectedIds.add(a.id));
  updateBatchBar();
  renderCards();
}

function deselectAllCards() {
  selectedIds.clear();
  updateBatchBar();
  renderCards();
}

function batchMoveCategory(cat) {
  if (!cat || selectedIds.size === 0) return;
  if (!confirm(`将 ${selectedIds.size} 个条目移动到分类"${cat}"？`)) return;
  animeList.forEach(a => { if (selectedIds.has(a.id)) a.category = cat; });
  saveData();
  selectedIds.clear();
  selectionMode = false;
  document.getElementById('cardGrid').classList.remove('selection-mode');
  document.getElementById('btnSelectMode').classList.remove('active');
  updateBatchBar();
  renderCards();
  showToast('已批量更新分类 ✓');
}

function batchMoveFolder(fid) {
  if (!fid || selectedIds.size === 0) return;
  const folderId = parseInt(fid) || null;
  animeList.forEach(a => { if (selectedIds.has(a.id)) a.folderId = folderId; });
  saveData();
  selectedIds.clear();
  selectionMode = false;
  document.getElementById('cardGrid').classList.remove('selection-mode');
  document.getElementById('btnSelectMode').classList.remove('active');
  updateBatchBar();
  renderCards();
  renderFolderList();
  showToast('已批量移入收藏夹 ✓');
}

function batchSetStatus(status) {
  if (!status || selectedIds.size === 0) return;
  animeList.forEach(a => {
    if (selectedIds.has(a.id)) {
      a.status = status;
      if (status === 'watched') a.watchedEpisodes = Array.from({length: a.totalEpisodes||12}, (_,i)=>i+1);
      else if (status === 'towatch') a.watchedEpisodes = [];
    }
  });
  saveData();
  selectedIds.clear();
  selectionMode = false;
  document.getElementById('cardGrid').classList.remove('selection-mode');
  document.getElementById('btnSelectMode').classList.remove('active');
  updateBatchBar();
  renderCards();
  showToast('已批量更新状态 ✓');
}

function batchDelete() {
  if (selectedIds.size === 0) return;
  if (!confirm(`确定要删除选中的 ${selectedIds.size} 个条目吗？此操作不可撤销。`)) return;
  animeList = animeList.filter(a => !selectedIds.has(a.id));
  selectedIds.clear();
