<script>
// ===== Data =====
const DATA_KEY = 'anime_tracker_data';
const FOLDERS_KEY = 'anime_folders';
const SOURCES_KEY = 'anime_sources_v2';
let animeList = [];
let folderList = [];
let sourceList = [];
let editingId = null;
let currentFilter = 'all';
let activeCategories = new Set();
let currentFolderId = null;
let currentStatusFilter = null;
let sortBy = null;       // 'score' | 'totalEpisodes' | null
let sortOrder = 'desc';  // 'asc' | 'desc'
let selectionMode = false;
let selectedIds = new Set();
let backendOnline = false;
let pendingCoverDataUrl = null;
let sourceResults = [];
let chosenSourceIdx = -1;
let searchTimer = null;
let detailPopupId = null;

function loadData() {
  try { animeList = JSON.parse(localStorage.getItem(DATA_KEY) || '[]'); } catch(e) { animeList = []; }
  var fixed = false;
  for (var i = 0; i < animeList.length; i++) {
    var a = animeList[i];
    if (!a.category || VALID_CATEGORIES.indexOf(a.category) < 0) {
      a.category = DEFAULT_CATEGORY;
      fixed = true;
    }
  }
  if (fixed) saveData();
  // Migrate from old key
  if (animeList.length === 0) {
    try {
      const old = localStorage.getItem('anime_tracker_v4');
      if (old) { animeList = JSON.parse(old); saveData(); }
    } catch(e) {}
  }
}
function saveData() {
  localStorage.setItem(DATA_KEY, JSON.stringify(animeList));
}
function loadFolders() {
  try { folderList = JSON.parse(localStorage.getItem(FOLDERS_KEY) || '[]'); } catch(e) { folderList = []; }
  // Migrate from old key
  if (folderList.length === 0) {
    try {
      const old = localStorage.getItem('anime_tracker_folders_v1');
      if (old) { folderList = JSON.parse(old); saveFolders(); }
    } catch(e) {}
  }
}
function saveFolders() {
  localStorage.setItem(FOLDERS_KEY, JSON.stringify(folderList));
}
async function loadSourceList() {
  try { sourceList = JSON.parse(localStorage.getItem(SOURCES_KEY) || '[]'); } catch(e) { sourceList = []; }
  // Migrate from old version: enabledSources in anime_tracker_settings_v2
  if (sourceList.length === 0) {
    try {
      const oldSettings = JSON.parse(localStorage.getItem('anime_tracker_settings_v2') || '{}');
      const enabled = oldSettings.enabledSources || [];
      const nameOverrides = oldSettings.builtInNames || {};
      const urlOverrides = oldSettings.builtInUrls || {};
      const hidden = oldSettings.hiddenBuiltIn || [];
      const migrated = [];
      // Built-in sources from old version
      const builtInDefs = [
        { key: 'bgm.tv', name: 'Bangumi 番组计划', url: 'https://bgm.tv/subject_search/{query}?cat=2' },
        { key: 'myanimelist.net', name: 'MyAnimeList', url: 'https://myanimelist.net/anime.php?q={query}' },
        { key: 'bilibili', name: 'Bilibili', url: 'https://search.bilibili.com/bangumi?keyword={query}' },
      ];
      for (const def of builtInDefs) {
        if (!hidden.includes(def.key)) {
          migrated.push({
            id: Date.now() + Math.random(),
            name: nameOverrides[def.key] || def.name,
            url: urlOverrides[def.key] || def.url,
            enabled: enabled.length === 0 || enabled.includes(def.key),
          });
        }
      }
      // Custom sources from old settings (if any stored locally)
      const customDefs = oldSettings.customSources || [];
      for (const cs of customDefs) {
        migrated.push({
          id: Date.now() + Math.random(),
          name: cs.name,
          url: cs.searchUrl,
          enabled: enabled.length === 0 || enabled.includes(cs.id || cs.key),
        });
      }
      if (migrated.length > 0) {
        sourceList = migrated;
        saveSourceList();
      }
    } catch(e) {}
  }
  // Fallback: fetch from server's custom-sources.json
  if (sourceList.length === 0) {
    try {
      const resp = await fetch('/api/custom-sources');
      if (resp.ok) {
        const serverSources = await resp.json();
        sourceList = serverSources.map(s => ({
          id: s.id, name: s.name, url: s.searchUrl, enabled: true
        }));
        if (sourceList.length > 0) saveSourceList();
      }
    } catch(e) {}
  }
}
function saveSourceList() {
  localStorage.setItem(SOURCES_KEY, JSON.stringify(sourceList));
}

// ===== Backend =====
async function checkBackend() {
  try {
    const resp = await fetch('/api/ping', { signal: AbortSignal.timeout(3000) });
    backendOnline = resp.ok;
  } catch(e) { backendOnline = false; }
  updateBackendStatus();
  if (backendOnline) {
    await loadSourceList();
  }
}

function updateBackendStatus() {
  const el = document.getElementById('backendStatus');
  const label = document.getElementById('backendLabel');
  el.classList.toggle('online', backendOnline);
  el.classList.toggle('offline', !backendOnline);
  label.textContent = backendOnline ? '后端已连接' : '后端未连接';
}

async function backendSearch(q) {
  if (!backendOnline) return [];
  try {
    var enabledIds = sourceList.filter(function(s) { return s.enabled !== false; }).map(function(s) { return s.id; });
    var params = 'q=' + encodeURIComponent(q);
    if (enabledIds.length > 0) params += '&sources=' + enabledIds.join(',');
    // Also pass custom URLs for each source
    for (var i = 0; i < sourceList.length; i++) {
      var s = sourceList[i];
      if (s.enabled !== false) params += '&url_' + encodeURIComponent(s.id) + '=' + encodeURIComponent(s.url);
    }
    var resp = await fetch('/api/search?' + params, { signal: AbortSignal.timeout(15000) });
    if (!resp.ok) return [];
    var data = await resp.json();
    return data.results || [];
  } catch(e) { return []; }
}

async function backendFetchUrls(urls) {
  if (!backendOnline) return [];
  try {
    const resp = await fetch('/api/fetch-urls', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ urls }),
      signal: AbortSignal.timeout(20000)
    });
    if (!resp.ok) return [];
    const data = await resp.json();
    return data.map((r, i) => { r._url = urls[i] || ''; return r; });
  } catch(e) { return []; }
}

async function aiEnrich(title) {
  if (!backendOnline) throw new Error('后端未连接');
  const apiKey = localStorage.getItem('anime_api_key') || '';
  const apiUrl = localStorage.getItem('anime_api_url') || 'https://api.deepseek.com';
  const resp = await fetch('/api/ai-enrich', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ title, apiKey, apiUrl }),
    signal: AbortSignal.timeout(60000)
  });
  if (!resp.ok) {
    const err = await resp.json().catch(() => ({}));
    throw new Error(err.error || `HTTP ${resp.status}`);
  }
  return resp.json();
}

// ===== Sources =====
function renderSourceList() {
  const container = document.getElementById('sidebarSources');
  container.innerHTML = sourceList.map(s =>
    `<div class="sidebar-source-item${s.enabled !== false ? ' enabled' : ''}" onclick="toggleSource(${s.id})" title="${escapeHtml(s.name)}${s.enabled !== false ? ' · 已启用' : ' · 已禁用'}">
      <span class="src-dot"></span>
      <span class="src-name">${escapeHtml(s.name)}</span>
      <span class="src-del" onclick="event.stopPropagation();deleteSource(${s.id})" title="删除来源">✕</span>
    </div>`
  ).join('');
}

function renderSourceManagerList() {
  var container = document.getElementById('sourceManagerList');
  if (!container) return;
  if (sourceList.length === 0) {
    container.innerHTML = '<div style="text-align:center;padding:24px;opacity:0.4;font-size:0.85rem">暂无搜索来源</div>';
    return;
  }
  var html = '';
  for (var i = 0; i < sourceList.length; i++) {
    var s = sourceList[i];
    var enabled = s.enabled !== false;
    var dotColor = enabled ? 'var(--color-success)' : 'var(--color-base-content)';
    var dotOpacity = enabled ? '1' : '0.25';
    var toggleLabel = enabled ? '已启用' : '已禁用';
    html += '<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;margin-bottom:4px;background:color-mix(in srgb, var(--color-base-content) 3%, transparent);border:1px solid transparent;transition:border-color 0.15s ease" onmouseenter="this.style.borderColor=\'color-mix(in srgb, var(--color-primary) 15%, transparent)\'" onmouseleave="this.style.borderColor=\'transparent\'">';
    html += '<span style="width:8px;height:8px;border-radius:50%;flex-shrink:0;background:' + dotColor + ';opacity:' + dotOpacity + '"></span>';
    html += '<div style="flex:1;min-width:0">';
    html += '<div style="font-size:0.85rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + escapeHtml(s.name) + '</div>';
    html += '<div style="font-size:0.72rem;opacity:0.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + escapeHtml(s.url) + '</div>';
    html += '</div>';
    html += '<button onclick="testSourceById(' + s.id + ',this)" style="padding:4px 8px;border-radius:6px;border:1px solid color-mix(in srgb, var(--color-info) 20%, transparent);background:transparent;color:var(--color-info);cursor:pointer;font-size:0.7rem;white-space:nowrap;font-family:inherit" title="测试连接">测试</button>';
    html += '<button onclick="toggleSource(' + s.id + ');renderSourceManagerList()" style="padding:4px 10px;border-radius:6px;border:1px solid color-mix(in srgb, var(--color-base-content) 12%, transparent);background:transparent;color:var(--color-base-content);cursor:pointer;font-size:0.75rem;white-space:nowrap;font-family:inherit">' + toggleLabel + '</button>';
    html += '<button onclick="deleteSource(' + s.id + ');renderSourceManagerList()" style="padding:4px 8px;border-radius:6px;border:none;background:transparent;color:var(--color-error);cursor:pointer;font-size:0.75rem;opacity:0.6;font-family:inherit" title="删除">✕</button>';
    html += '</div>';
  }
  container.innerHTML = html;
}

function openSourceManager() {
  renderSourceManagerList();
  document.getElementById('sourceManagerOverlay').style.display = 'flex';
}

function closeSourceManager() {
  document.getElementById('sourceManagerOverlay').style.display = 'none';
}

function toggleSource(id) {
  const s = sourceList.find(x => x.id === id);
  if (!s) return;
  s.enabled = s.enabled === false;
  saveSourceList();
  renderSourceManagerList();
}

function deleteSource(id) {
  if (!confirm('确定删除这个搜索来源吗？')) return;
  sourceList = sourceList.filter(s => s.id !== id);
  saveSourceList();
  renderSourceManagerList();
}

function openAddSourceModal() {
  document.getElementById('sourceModalTitle').textContent = '添加搜索来源';
  document.getElementById('srcName').value = '';
  document.getElementById('srcUrl').value = '';
  document.getElementById('btnSaveSource').textContent = '添加';
  document.getElementById('srcName')._editId = null;
  document.getElementById('srcTestResult').style.display = 'none';
  document.getElementById('sourceModalOverlay').style.display = 'flex';
  setTimeout(() => document.getElementById('srcName').focus(), 100);
}

function closeAddSourceModal() {
  document.getElementById('sourceModalOverlay').style.display = 'none';
}

async function testSourceUrl() {
  var url = document.getElementById('srcUrl').value.trim();
  if (!url) { showToast('请先输入搜索链接模板'); return; }
  if (!url.includes('{query}')) { showToast('搜索链接必须包含 {query} 占位符'); return; }
  var resultDiv = document.getElementById('srcTestResult');
  resultDiv.style.display = 'block';
  resultDiv.style.color = 'var(--color-base-content)';
  resultDiv.style.opacity = '0.7';
  resultDiv.textContent = '正在测试...';
  try {
    var resp = await fetch('/api/test-search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ searchUrl: url, query: 'test' })
    });
    if (resp.ok) {
      var data = await resp.json();
      resultDiv.style.color = 'var(--color-success)';
      resultDiv.style.opacity = '1';
      resultDiv.innerHTML = '✓ 连接成功！返回 ' + (data.results ? data.results.length : 0) + ' 条结果';
    } else {
      var err = await resp.json().catch(function() { return { error: 'HTTP ' + resp.status }; });
      resultDiv.style.color = 'var(--color-error)';
      resultDiv.style.opacity = '1';
      resultDiv.textContent = '✗ 测试失败：' + (err.error || '未知错误');
    }
  } catch(e) {
    resultDiv.style.color = 'var(--color-error)';
    resultDiv.style.opacity = '1';
    resultDiv.textContent = '✗ 网络错误：' + e.message;
  }
}

async function testSourceById(id, btn) {
  var s = sourceList.find(function(x) { return x.id === id; });
  if (!s) return;
  var origText = btn.textContent;
  btn.textContent = '...';
  btn.disabled = true;
  try {
    var resp = await fetch('/api/test-search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ searchUrl: s.url, query: 'test' })
    });
    if (resp.ok) {
      var data = await resp.json();
      showToast('✓ ' + s.name + ' 连接成功，返回 ' + (data.results ? data.results.length : 0) + ' 条结果');
    } else {
      var err = await resp.json().catch(function() { return { error: 'HTTP ' + resp.status }; });
      showToast('✗ ' + s.name + ' 测试失败：' + (err.error || '未知错误'));
    }
  } catch(e) {
    showToast('✗ ' + s.name + ' 网络错误：' + e.message);
  }
  btn.textContent = origText;
  btn.disabled = false;
}

function saveSource() {
  const name = document.getElementById('srcName').value.trim();
  const url = document.getElementById('srcUrl').value.trim();
  if (!name || !url) { showToast('请填写来源名称和搜索链接模板'); return; }
  if (!url.includes('{query}')) { showToast('搜索链接必须包含 {query} 占位符'); return; }
  const editId = document.getElementById('srcName')._editId;
  if (editId) {
    const s = sourceList.find(x => x.id === editId);
    if (s) { s.name = name; s.url = url; }
  } else {
    sourceList.push({ id: Date.now(), name, url, enabled: true });
  }
  saveSourceList();
  renderSourceManagerList();
  closeAddSourceModal();
  showToast(editId ? '来源已更新 ✓' : '来源已添加 ✓');
}

function openBatchSourceModal() {
  document.getElementById('batchSourceInput').value = '';
  document.getElementById('batchSourceModalOverlay').style.display = 'flex';
  setTimeout(() => document.getElementById('batchSourceInput').focus(), 100);
}

function closeBatchSourceModal() {
  document.getElementById('batchSourceModalOverlay').style.display = 'none';
}

function batchSaveSources() {
  const raw = document.getElementById('batchSourceInput').value.trim();
  if (!raw) { showToast('请输入来源数据'); return; }
  const lines = raw.split('\n').map(l => l.trim()).filter(Boolean);
  let added = 0, skipped = 0;
  for (const line of lines) {
    const idx = line.indexOf(' ');
    if (idx === -1) { skipped++; continue; }
    const name = line.substring(0, idx).trim();
    const url = line.substring(idx + 1).trim();
    if (!name || !url) { skipped++; continue; }
    if (!url.includes('{query}')) { skipped++; continue; }
    sourceList.push({ id: Date.now() + Math.random(), name, url, enabled: true });
    added++;
  }
  if (added > 0) { saveSourceList(); renderSourceManagerList(); }
  closeBatchSourceModal();
  showToast(added > 0 ? `已添加 ${added} 个来源${skipped > 0 ? `，跳过 ${skipped} 行` : ''} ✓` : `未添加任何来源（请检查格式：名称 链接）`);
}

// ===== Search History =====
const SEARCH_HISTORY_KEY = 'anime_search_history';
const MAX_HISTORY = 20;
let searchHistory = [];

function loadSearchHistory() {
  try { searchHistory = JSON.parse(localStorage.getItem(SEARCH_HISTORY_KEY) || '[]'); } catch(e) { searchHistory = []; }
}

function saveSearchTerm() {
  const q = document.getElementById('searchInput').value.trim();
  if (!q) return;
  searchHistory = searchHistory.filter(t => t !== q);
  searchHistory.unshift(q);
  if (searchHistory.length > MAX_HISTORY) searchHistory.pop();
  localStorage.setItem(SEARCH_HISTORY_KEY, JSON.stringify(searchHistory));
  renderCards();
  hideSearchHistory();
}

function showSearchHistory() {
  if (searchHistory.length === 0) return;
  var dd = document.getElementById('searchHistoryDropdown');
  var html = '';
  for (var i = 0; i < searchHistory.length; i++) {
    var t = searchHistory[i];
    var et = escapeHtml(t);
    html += '<div class="search-history-item" onmousedown="event.preventDefault();document.getElementById(\'searchInput\').value=\'' + et.replace(/'/g, "\\'") + '\';saveSearchTerm()">';
    html += '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
    html += '<span style="flex:1">' + et + '</span>';
    html += '</div>';
  }
  html += '<div class="search-history-clear" onmousedown="event.preventDefault();clearSearchHistory()">';
  html += '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor" width="14" height="14"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>';
  html += '清除搜索记录</div>';
  dd.innerHTML = html;
  dd.classList.add('show');
}

function hideSearchHistory() {
  document.getElementById('searchHistoryDropdown').classList.remove('show');
}

function clearSearchHistory() {
  searchHistory = [];
  localStorage.removeItem(SEARCH_HISTORY_KEY);
  document.getElementById('searchHistoryDropdown').innerHTML = '';
  hideSearchHistory();
  showToast('搜索记录已清除 ✓');
}

document.addEventListener('click', e => {
  if (!e.target.closest('#searchWrap')) hideSearchHistory();
});

// ===== Filtering =====
function updateStatHighlight(status) {
  ['statBtnTowatch','statBtnWatching','statBtnWatched'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.classList.remove('active');
  });
  var map = { towatch: 'statBtnTowatch', watching: 'statBtnWatching', watched: 'statBtnWatched' };
  var btn = document.getElementById(map[status]);
  if (btn) btn.classList.add('active');
}

function setFilter(filter) {
  currentFilter = filter;
  currentFolderId = null;
  activeCategories.clear();
  currentStatusFilter = null;
  document.getElementById('searchInput').value = '';
  document.querySelectorAll('.nav-item[data-filter]').forEach(el => el.classList.remove('active'));
  document.querySelector(`.nav-item[data-filter="${filter}"]`)?.classList.add('active');
  document.querySelectorAll('[data-cat]').forEach(el => el.classList.remove('active'));
  updateStatHighlight(filter);
  renderCards();
}

function setStatusFilter(status) {
  // Toggle: if same status already active, turn it off
  if (currentStatusFilter === status) {
    currentStatusFilter = null;
    updateStatHighlight(null);
    if (activeCategories.size === 0 && !currentFolderId) {
      currentFilter = 'all';
      document.querySelectorAll('.nav-item[data-filter]').forEach(el => el.classList.remove('active'));
      document.querySelector('.nav-item[data-filter="all"]')?.classList.add('active');
    }
    renderCards();
    return;
  }
  // When no category/folder context, sync sidebar highlight
  if (activeCategories.size === 0 && !currentFolderId) {
    currentFilter = status;
    document.querySelectorAll('.nav-item[data-filter]').forEach(el => el.classList.remove('active'));
    document.querySelector('.nav-item[data-filter="' + status + '"]')?.classList.add('active');
    document.querySelectorAll('[data-cat]').forEach(el => el.classList.remove('active'));
  }
  currentStatusFilter = status;
  document.getElementById('searchInput').value = '';
  updateStatHighlight(status);
  renderCards();
}

function setCategoryFilter(cat) {
  currentFilter = 'category';
  currentFolderId = null;
  currentStatusFilter = null;
  if (activeCategories.has(cat)) activeCategories.delete(cat);
  else { activeCategories.clear(); activeCategories.add(cat); }
  document.getElementById('searchInput').value = '';
  document.querySelectorAll('.nav-item[data-filter]').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('[data-cat]').forEach(el => el.classList.toggle('active', activeCategories.has(el.dataset.cat)));
  updateStatHighlight(null);
  renderCards();
}

function getFilteredList() {
  let list = animeList;
  // Category / folder filter
  if (currentFilter === 'folder' && currentFolderId) {
    list = list.filter(a => a.folderId === currentFolderId);
  } else if (currentFilter === 'category' && activeCategories.size > 0) {
    list = list.filter(a => activeCategories.has(a.category));
  }
  // Status filter (overlay or standalone)
  if (currentStatusFilter) {
    list = list.filter(a => a.status === currentStatusFilter);
  } else if (currentFilter !== 'folder' && currentFilter !== 'category' && currentFilter !== 'all') {
    list = list.filter(a => a.status === currentFilter);
  }
  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  if (q) list = list.filter(a => a.title.toLowerCase().includes(q));
  // Sort
  if (sortBy) {
    list = list.slice().sort(function(a, b) {
      var va = sortBy === 'score' ? (a.score || 0) : (a.totalEpisodes || 0);
      var vb = sortBy === 'score' ? (b.score || 0) : (b.totalEpisodes || 0);
      return sortOrder === 'desc' ? vb - va : va - vb;
    });
  }
  return list;
}

function applySort() {
  sortBy = document.getElementById('sortBy').value || null;
  if (sortBy) document.getElementById('sortOrderBtn').classList.add('active');
  else document.getElementById('sortOrderBtn').classList.remove('active');
  renderCards();
}

function toggleSortOrder() {
  sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
  document.getElementById('sortOrderBtn').textContent = sortOrder === 'desc' ? '↓' : '↑';
  renderCards();
}

// ===== Cards =====
function getCoverGradient(id) {
  const colors = [
    ['rgba(0,200,255,0.2)', 'rgba(168,85,247,0.15)'],
    ['rgba(168,85,247,0.2)', 'rgba(255,68,113,0.15)'],
    ['rgba(0,152,219,0.2)', 'rgba(0,214,143,0.15)'],
    ['rgba(240,160,0,0.2)', 'rgba(0,200,255,0.15)'],
    ['rgba(124,58,237,0.2)', 'rgba(0,229,255,0.15)'],
    ['rgba(0,214,143,0.2)', 'rgba(0,152,219,0.15)'],
  ];
  return colors[id % colors.length];
}

const VALID_CATEGORIES = ['chinese_anime','japanese_anime','theatrical_anime','anime_movie','movie','tv_drama','web_drama','documentary'];
const DEFAULT_CATEGORY = 'japanese_anime';
function normalizeCategory(c) {
  if (c && VALID_CATEGORIES.indexOf(c) >= 0) return c;
  return DEFAULT_CATEGORY;
}
const CAT_ICONS = {
  chinese_anime:'🇨🇳', japanese_anime:'🇯🇵', theatrical_anime:'🎬',
  anime_movie:'🎥', movie:'🍿', tv_drama:'📺', web_drama:'💻', documentary:'📚'
};

function renderCards() {
  const grid = document.getElementById('cardGrid');
  const list = getFilteredList();

  // Update badges and stats — stat counts use category/folder context only
  let statsBase = animeList;
  if (currentFilter === 'category' && activeCategories.size > 0) {
    statsBase = animeList.filter(a => activeCategories.has(a.category));
  } else if (currentFilter === 'folder' && currentFolderId) {
    statsBase = animeList.filter(a => a.folderId === currentFolderId);
  }
  const counts = { all: animeList.length, towatch: 0, watching: 0, watched: 0 };
  const catCounts = {};
  statsBase.forEach(a => { counts[a.status] = (counts[a.status]||0)+1; });
  animeList.forEach(a => { var c = a.category || DEFAULT_CATEGORY; catCounts[c] = (catCounts[c]||0)+1; });
  ['All','Towatch','Watching','Watched'].forEach(k => {
    const el = document.getElementById('badge'+k);
    if (el) el.textContent = counts[k.toLowerCase()];
  });
  ['ChineseAnime','JapaneseAnime','TheatricalAnime','AnimeMovie','Movie','TvDrama','WebDrama','Documentary'].forEach(k => {
    const el = document.getElementById('badge'+k);
    const key = k.replace(/([A-Z])/g, '_$1').toLowerCase().replace(/^_/, '');
    if (el) el.textContent = catCounts[key] || 0;
  });
  document.getElementById('statTowatch').textContent = counts.towatch;
  document.getElementById('statWatching').textContent = counts.watching;
  document.getElementById('statWatched').textContent = counts.watched;

  if (list.length === 0) {
    grid.innerHTML = `<div class="empty-state"><div class="empty-icon">🎬</div><p>${animeList.length === 0 ? '还没有添加任何番剧，点击「＋ 添加番剧」开始吧！' : '没有找到匹配的番剧'}</p></div>`;
    return;
  }

  const st = { towatch: '待看', watching: '正在看', watched: '已看完' };
  grid.innerHTML = list.map((a, idx) => {
    const wc = a.watchedEpisodes ? a.watchedEpisodes.length : 0;
    const total = a.totalEpisodes || 12;
    const progress = total > 0 ? (wc / total) * 100 : 0;
    const catBadge = a.category && CAT_ICONS[a.category]
      ? `<span class="card-cat-badge">${CAT_ICONS[a.category]}</span>` : '';

    let coverHTML;
    if (a.cover) {
      coverHTML = `<img class="card-cover-img" src="${escapeHtml(a.cover)}" alt="${escapeHtml(a.title)}" loading="lazy" decoding="async" width="240" height="320" referrerpolicy="no-referrer" onerror="if(this.src.slice(0,4)!=='/api'){this.src='/api/proxy-image?url='+encodeURIComponent(this.src)}else{this.style.display='none';this.nextElementSibling.style.display='flex'}">`;
      const [c1,c2] = getCoverGradient(a.id);
      coverHTML += `<div class="card-cover-gradient" style="display:none;background:linear-gradient(135deg,${c1},${c2})">${escapeHtml(a.title[0]||'')}</div>`;
    } else {
      const [c1,c2] = getCoverGradient(a.id);
      coverHTML = `<div class="card-cover-gradient" style="background:linear-gradient(135deg,${c1},${c2})">${escapeHtml(a.title[0]||'番')}</div>`;
    }

    const genreTags = `<div class="card-genres">${(a.genres && a.genres.length > 0) ? a.genres.slice(0,4).map(g => `<span class="card-genre-tag">${escapeHtml(g)}</span>`).join('') : ''}</div>`;

    const isSelected = selectedIds.has(a.id);
    return `
      <div class="anime-card${isSelected ? ' selected' : ''}" style="animation-delay:${idx*0.04}s" id="card-${a.id}" data-aid="${a.id}" onclick="handleCardClick(${a.id})">
        <div class="card-select-check">✓</div>
        <div class="card-select-overlay"></div>
        <div class="card-cover">${coverHTML}<div class="card-cover-overlay"></div>${catBadge}<span class="card-status-badge ${a.status}">${st[a.status]}</span>${(!a.synopsis || !a.synopsis.trim()) ? `<button class="card-ai-hint" onclick="event.stopPropagation();aiFillCard(${a.id})" title="AI补全信息">AI</button>` : ''}</div>
        <div class="card-body">
          <div class="card-title" title="${escapeHtml(a.title)}">${escapeHtml(a.title)}</div>
          ${genreTags}
          <div class="card-meta">
            <div style="flex:1;min-width:0;"><div class="card-progress"><span>${wc}/${total} 集</span><div class="card-progress-bar"><div class="card-progress-bar-fill ${a.status}" style="transform:scaleX(${(progress/100).toFixed(3)})"></div></div></div></div>
            ${a.score ? `<span class="card-rating">★ ${a.score.toFixed(1)}</span>` : ''}
          </div>
        </div>
      </div>`;
  }).join('');
  if (detailPopupId !== null) renderDetailPopup(detailPopupId);
}

function handleCardClick(aid) {
  if (selectionMode) {
    toggleCardSelect(aid);
  } else {
    try {
      openEditModal(aid);
    } catch(e) {
      showToast('错误: ' + e.message);
      console.error(e);
    }
  }
}

document.getElementById('cardGrid').addEventListener('contextmenu', function(e) {
  const card = e.target.closest('.anime-card');
  if (!card) return;
  e.preventDefault();
  const aid = parseInt(card.dataset.aid);
  if (isNaN(aid)) return;
