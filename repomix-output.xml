  .sidebar-source-item.enabled .src-dot { background: var(--color-success, #00d68f); }
  .src-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; background: var(--color-base-content); opacity: 0.3; }
  .src-name { flex: 1; }
