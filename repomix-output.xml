<!DOCTYPE html>
<html lang="zh-CN" data-theme="anime">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>追番管理器</title>
<link rel="stylesheet" href="/public/output.css">
<style>
  /* ===== App Shell & Layout ===== */
  :root {
    --sidebar-w: 240px;
    --sidebar-collapsed: 56px;
    --topbar-h: 56px;
    --sidebar-ease: cubic-bezier(0.4, 0, 0.2, 1);
    --sidebar-duration: 0.25s;
    --item-h: 40px;
    --icon-w: 36px;
    --radius-selector: 0.375rem;
    --radius-box: 0.5rem;
    --radius-field: 0.375rem;
    font-family: 'Inter','PingFang SC','Microsoft YaHei',system-ui,sans-serif;
  }
  .app { display: flex; min-height: 100vh; }
  .sidebar-overlay { display: none; }

  /* Main content — only margin-left transitions */
  .main {
    flex: 1; margin-left: var(--sidebar-w); min-width: 0;
    will-change: margin-left;
    transition: margin-left var(--sidebar-duration) var(--sidebar-ease);
  }
  .app:has(.sidebar.collapsed) .main { margin-left: var(--sidebar-collapsed); }

  /* ===== Sidebar outer — ONLY width transitions here ===== */
  .sidebar {
    position: fixed; left: 0; top: 0; bottom: 0; z-index: 100;
    width: var(--sidebar-w);
    display: flex; flex-direction: column;
    overflow-y: auto; overflow-x: hidden;
    will-change: width;
    transition: width var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed { width: var(--sidebar-collapsed); }

  /* Brand — logo fixed, text animates */
  .sidebar-brand {
    display: flex; align-items: center;
    height: var(--topbar-h); padding: 0 10px; flex-shrink: 0;
  }
  .sidebar-logo {
    width: var(--icon-w); height: var(--topbar-h);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .sidebar-logo svg { width: 24px; height: 24px; }
  .sidebar-brand-text {
    font-size: 0.95rem; font-weight: 700; letter-spacing: -0.01em;
    white-space: nowrap; overflow: hidden;
    padding-left: 8px;
    will-change: max-width, opacity;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .sidebar-brand-text { max-width: 0; opacity: 0; padding-left: 0; }

  /* Nav container */
  .sidebar-nav { padding: 4px 6px; flex: 1; overflow-y: auto; overflow-x: hidden; }

  /* Section header — fixed height, only text/line collapse */
  .nav-section-header {
    display: flex; align-items: center;
    height: 32px; padding: 0 4px; margin-top: 8px; flex-shrink: 0;
    overflow: hidden;
  }
  .nav-section-glow-label {
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; white-space: nowrap;
    color: var(--color-base-content); opacity: 0.40;
    will-change: max-width, opacity;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .nav-section-energy-line {
    flex: 1; height: 1px; min-width: 0; margin-left: 8px;
    background: color-mix(in srgb, var(--color-base-content) 12%, transparent);
    will-change: max-width, opacity;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .nav-section-glow-label { max-width: 0; opacity: 0; }
  .sidebar.collapsed .nav-section-energy-line { max-width: 0; opacity: 0; margin-left: 0; }

  .nav-section-geo-decor,
  .nav-energy-bar,
  .nav-glow-dot { display: none; }

  /* Nav item — fixed 40px height, 36px icon slot, never changes */
  .nav-item {
    display: flex; align-items: center;
    width: 100%; height: var(--item-h); padding: 0 6px; margin-bottom: 1px;
    border: none; cursor: pointer; position: relative;
    font-family: inherit; font-size: 0.85rem; font-weight: 500;
    letter-spacing: -0.01em; text-align: left;
    border-radius: 6px;
    background: transparent; color: var(--color-base-content);
    transition: background 0.15s ease, color 0.15s ease;
    overflow: hidden; flex-shrink: 0;
  }
  .nav-item:hover { background: color-mix(in srgb, var(--color-base-content) 6%, transparent); }
  .nav-item:active { background: color-mix(in srgb, var(--color-base-content) 8%, transparent); }
  .nav-item.active {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Active indicator — left bar, GPU-accelerated */
  .nav-item.active::before {
    content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--color-primary);
    transform-origin: left center;
    will-change: transform;
    transition: transform var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .nav-item.active::before { transform: scaleX(0); }

  /* Sub-items — indent only when expanded */
  .nav-sub { padding-left: 42px !important; font-size: 0.82rem; }
  .sidebar.collapsed .nav-sub { padding-left: 6px !important; }

  /* Icon wrapper — fixed 36×40px, always at same position */
  .nav-icon {
    width: var(--icon-w); height: var(--item-h);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  .nav-item:hover .nav-icon { transform: scale(1.08); }
  .nav-icon svg { width: 20px; height: 20px; stroke: currentColor; }

  /* Label — max-width + opacity, no reflow, GPU layer */
  .nav-label {
    white-space: nowrap; overflow: hidden;
    padding-left: 8px;
    will-change: max-width, opacity;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .nav-label { max-width: 0; opacity: 0; padding-left: 0; }

  /* Badge — opacity only, no layout change */
  .nav-badge {
    font-size: 0.68rem; font-weight: 600;
    min-width: 20px; height: 18px; line-height: 18px; text-align: center;
    border-radius: 9999px; padding: 0 6px; margin-left: auto;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    will-change: opacity;
    transition: opacity var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .nav-badge { opacity: 0; }

  /* Toggle button */
  .sidebar-toggle {
    position: sticky; bottom: 12px; left: 0; right: 0;
    margin: 0 auto; width: 36px; height: 36px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    background: color-mix(in srgb, var(--color-base-content) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-base-content) 15%, transparent);
    color: var(--color-base-content);
    cursor: pointer; outline: none; opacity: 0.65;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar-toggle:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--color-base-content) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
    color: var(--color-primary);
  }
  .sidebar-toggle svg {
    width: 16px; height: 16px; flex-shrink: 0;
    stroke: currentColor;
    transition: transform var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .sidebar-toggle svg { transform: rotate(180deg); }

  /* Bottom sections — max-height + opacity, NO display:none */
  .sidebar-section {
    padding: 12px 10px; flex-shrink: 0;
    max-height: 800px;
    overflow: hidden;
    will-change: max-height, opacity;
    transition: all var(--sidebar-duration) var(--sidebar-ease);
  }
  .sidebar.collapsed .sidebar-section { max-height: 0; opacity: 0; padding-top: 0; padding-bottom: 0; margin: 0; }
  .sidebar-collapsed-btn {
    display: none; align-items: center; justify-content: center;
    width: 40px; height: 40px; margin: 4px auto; padding: 0; flex-shrink: 0;
    border: none; border-radius: var(--radius-selector, 0.25rem);
    background: transparent; color: var(--color-base-content);
    font-size: 1.1rem; cursor: pointer; font-family: inherit;
    opacity: 0.5; transition: opacity 0.15s ease, background 0.15s ease;
  }
  .sidebar-collapsed-btn:hover { opacity: 0.8; background: color-mix(in srgb, var(--color-primary) 8%, transparent); }
  .sidebar.collapsed .sidebar-collapsed-btn { display: flex; }
  .sidebar-section-title {
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em;
