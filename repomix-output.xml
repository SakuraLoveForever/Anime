    pointer-events: none;
  }
  .card-cover-gradient {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; font-weight: 800;
    color: rgba(255,255,255,0.15);
  }
  .card-cat-badge {
    position: absolute; top: 8px; left: 8px; z-index: 4;
    padding: 3px 10px; border-radius: 9999px;
    font-size: 0.62rem; font-weight: 600; letter-spacing: 0.06em;
    background: color-mix(in srgb, var(--color-primary) 25%, transparent);
    color: var(--color-primary-content); backdrop-filter: blur(4px);
  }
  .card-status-badge {
    position: absolute; bottom: 8px; left: 8px; z-index: 4;
    padding: 3px 10px; border-radius: 9999px;
    font-size: 0.64rem; font-weight: 600;
    backdrop-filter: blur(4px);
  }
  .card-status-badge.towatch { background: color-mix(in srgb, #7c3aed 60%, transparent); color: #fff; }
  .card-status-badge.watching { background: color-mix(in srgb, #f0a000 60%, transparent); color: #fff; }
  .card-status-badge.watched { background: color-mix(in srgb, #00d68f 60%, transparent); color: #000; }

  .card-ai-hint {
    position: absolute; bottom: 8px; right: 8px;
    width: 26px; height: 26px; border-radius: var(--radius-selector, 0.25rem);
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    color: var(--color-primary); font-size: 0.55rem; font-weight: 700;
    cursor: pointer; z-index: 5; display: flex;
    align-items: center; justify-content: center; letter-spacing: 0.05em;
    font-family: inherit; line-height: 1;
    transition: background 0.2s ease;
  }
  .card-ai-hint:hover { background: color-mix(in srgb, var(--color-primary) 25%, transparent); }

  .card-body { padding: 14px; display: flex; flex-direction: column; flex: 1; }
  .card-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-height: 1.3em; }
  .card-genres { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; min-height: 44px; align-items: flex-start; align-content: flex-start; }
  .card-genre-tag {
    padding: 2px 7px; border-radius: 9999px;
    font-size: 0.64rem; letter-spacing: 0.03em;
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    color: var(--color-primary); white-space: nowrap;
    line-height: 1.5;
  }
  .card-meta { display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 10px; }
  .card-progress { font-size: 0.75rem; }
  .card-progress-bar {
    margin-top: 4px; height: 3px; border-radius: 2px;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    overflow: hidden;
  }
  .card-progress-bar-fill { height: 100%; width: 100%; border-radius: 2px; transform-origin: left; }
  .card-progress-bar-fill.towatch { background: #7c3aed; }
  .card-progress-bar-fill.watching { background: #f0a000; }
  .card-progress-bar-fill.watched { background: #00d68f; }
  .card-rating { font-size: 0.78rem; font-weight: 600; color: var(--color-warning, #f0a000); white-space: nowrap; }

  .card-select-overlay {
    position: absolute; inset: 0; z-index: 5;
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    border: 1px solid var(--color-primary);
    pointer-events: none; display: none;
  }
  .card-select-check {
    position: absolute; top: 8px; right: 8px; z-index: 6;
    width: 20px; height: 20px; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.4);
    display: none; align-items: center; justify-content: center;
    font-size: 0.65rem; color: #fff;
  }
  .selection-mode .card-select-check { display: flex; }
  .anime-card.selected .card-select-check { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-content); }

  /* ===== Batch Bar ===== */
  .batch-bar {
    position: sticky; top: var(--topbar-h); z-index: 40;
    display: flex; align-items: center; gap: 12px;
    padding: 10px 20px; margin-bottom: 16px;
    background: color-mix(in srgb, var(--color-base-100) 90%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    border-radius: var(--radius-selector, 0.25rem);
    animation: slideDown 0.2s ease;
  }
  .batch-bar .count { font-size: 0.82rem; color: var(--color-primary); font-weight: 500; letter-spacing: 0.04em; }
  .batch-bar select {
    padding: 6px 10px; border-radius: var(--radius-selector, 0.25rem);
    background: transparent; border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-base-content); font-size: 0.8rem; outline: none; font-family: inherit;
  }
  .batch-bar select option, .batch-bar select optgroup { background: var(--color-base-100); color: var(--color-base-content); }
  .batch-bar select optgroup { font-weight: 600; color: var(--color-primary); }
  .batch-action-btn {
    padding: 6px 14px; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    background: transparent; color: var(--color-base-content); cursor: pointer;
    font-size: 0.8rem; font-family: inherit; letter-spacing: 0.03em;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .batch-action-btn:hover { border-color: color-mix(in srgb, var(--color-primary) 25%, transparent); color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 4%, transparent); }
  .batch-action-btn.danger { color: var(--color-error); border-color: color-mix(in srgb, var(--color-error) 20%, transparent); }
  .batch-action-btn.danger:hover { background: color-mix(in srgb, var(--color-error) 8%, transparent); }

  /* ===== Detail Popup ===== */
  .detail-overlay {
    position: fixed; inset: 0; z-index: 150;
    background: rgba(0,0,0,0.25);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    animation: fadeIn 0.15s ease;
  }
  .detail-popup {
    position: absolute; z-index: 151; pointer-events: auto;
    background: var(--color-base-100);
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-radius: 6px;
    width: 360px; max-height: 70vh;
    overflow-y: auto; padding: 20px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    animation: popupIn 0.2s cubic-bezier(0.16,1,0.3,1);
  }
  .detail-popup-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; gap: 8px; }
  .detail-popup-title { font-size: 1.05rem; font-weight: 700; flex: 1; min-width: 0; }
  .detail-popup-close {
    width: 28px; height: 28px; border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    color: var(--color-base-content); cursor: pointer; font-size: 0.85rem; flex-shrink: 0;
    font-family: inherit; display: flex; align-items: center; justify-content: center;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .detail-popup-close:hover { background: color-mix(in srgb, var(--color-error) 15%, transparent); color: var(--color-error); border-color: color-mix(in srgb, var(--color-error) 30%, transparent); }
  .detail-popup-meta { display: flex; gap: 10px; margin-bottom: 10px; font-size: 0.78rem; opacity: 0.7; flex-wrap: wrap; align-items: center; }
  .detail-popup-section { margin-top: 14px; }
  .detail-popup-section-title { font-size: 0.75rem; font-weight: 600; opacity: 0.5; margin-bottom: 6px; }
  .detail-popup-synopsis { font-size: 0.8rem; opacity: 0.75; line-height: 1.6; max-height: 120px; overflow-y: auto; }
  .ai-fill-mini-btn {
    font-size: 0.68rem; padding: 4px 10px; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    color: var(--color-primary); cursor: pointer; font-family: inherit;
    font-weight: 500; letter-spacing: 0.03em;
    transition: background 0.2s ease;
  }
  .ai-fill-mini-btn:hover { background: color-mix(in srgb, var(--color-primary) 10%, transparent); }

  /* ===== Episode Grid ===== */
  .episode-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr)); gap: 8px; }
  .episode-block {
    aspect-ratio: 1; border-radius: var(--radius-selector, 0.25rem);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.82rem; font-weight: 600;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
    background: transparent; color: var(--color-base-content); opacity: 0.5;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; user-select: none;
    font-family: 'SF Mono','JetBrains Mono','Consolas',monospace;
  }
  .episode-block:hover { border-color: color-mix(in srgb, var(--color-primary) 20%, transparent); color: var(--color-primary); opacity: 1; background: color-mix(in srgb, var(--color-primary) 4%, transparent); }
  .episode-block.watched { background: color-mix(in srgb, var(--color-success) 10%, transparent); border-color: color-mix(in srgb, var(--color-success) 30%, transparent); color: var(--color-success); opacity: 1; }
  .episode-actions { display: flex; gap: 8px; margin-top: 12px; }
  .episode-action-btn {
    padding: 5px 12px; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    background: transparent; color: var(--color-base-content); opacity: 0.7;
    font-size: 0.76rem; letter-spacing: 0.03em;
    cursor: pointer; font-family: inherit;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .episode-action-btn:hover { border-color: color-mix(in srgb, var(--color-primary) 25%, transparent); color: var(--color-primary); opacity: 1; background: color-mix(in srgb, var(--color-primary) 4%, transparent); }

  /* ===== Modals ===== */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    display: flex; align-items: flex-start; justify-content: center;
    animation: fadeIn 0.2s ease; padding: 40px 20px 20px; overflow-y: auto;
  }
  .edit-modal-box {
    background: var(--color-base-200);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-box, 0.5rem);
    padding: 28px; width: 100%; max-width: 540px;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-primary) 15%, transparent),
                0 0 50px color-mix(in srgb, var(--color-primary) 25%, transparent),
                0 12px 40px rgba(0,0,0,0.8);
    animation: slideUp 0.3s ease;
  }
  .edit-modal-box.small { max-width: 420px; }
  .edit-modal-box h2 { font-size: 1.2rem; font-weight: 700; margin-bottom: 20px; color: var(--color-primary); letter-spacing: 0.06em; }
  .modal-note {
    font-size: 0.78rem; opacity: 0.5; margin-bottom: 16px;
    padding: 10px 14px; border-radius: 6px;
    background: color-mix(in srgb, var(--color-primary) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
  }
  .modal-field { margin-bottom: 16px; }
  .modal-field label { display: block; font-size: 0.78rem; font-weight: 500; opacity: 0.7; margin-bottom: 6px; letter-spacing: 0.04em; }
  .modal-field input, .modal-field select, .modal-field textarea {
    width: 100%; padding: 10px 12px;
    background: color-mix(in srgb, var(--color-primary) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    border-radius: 6px;
    color: var(--color-base-content); font-size: 0.9rem;
    outline: none; font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .modal-field select option, .modal-field select optgroup { background: var(--color-base-100); color: var(--color-base-content); }
  .modal-field select optgroup { font-weight: 600; opacity: 0.7; font-style: normal; }
  .modal-field textarea { resize: vertical; min-height: 70px; }
  .modal-field input:focus, .modal-field select:focus, .modal-field textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 15%, transparent); }
  .modal-field input[type="file"] { padding: 8px 10px; }
  .modal-field input[type="file"]::file-selector-button {
    padding: 5px 12px; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    background: transparent; color: var(--color-base-content);
    cursor: pointer; font-family: inherit; margin-right: 10px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .modal-field input[type="file"]::file-selector-button:hover { border-color: color-mix(in srgb, var(--color-primary) 25%, transparent); color: var(--color-primary); }
  .modal-field-row { display: flex; gap: 12px; }
  .modal-field-row > * { flex: 1; }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 4px; }
  .btn-cancel {
    padding: 9px 18px; border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    background: transparent; color: var(--color-base-content); opacity: 0.7; letter-spacing: 0.03em;
    cursor: pointer; font-family: inherit; font-size: 0.85rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .btn-cancel:hover { border-color: color-mix(in srgb, var(--color-primary) 20%, transparent); opacity: 1; }
  .btn-save {
    padding: 9px 22px; border-radius: 6px; border: 1px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    color: var(--color-primary); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.04em;
    cursor: pointer; font-family: inherit;
    transition: background 0.2s ease;
  }
  .btn-save:hover { background: color-mix(in srgb, var(--color-primary) 15%, transparent); }
  .btn-save:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-ai-fill {
    padding: 9px 14px; border-radius: 6px;
    border: 1px solid var(--color-primary); background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    color: var(--color-primary); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.03em;
    cursor: pointer; font-family: inherit; white-space: nowrap;
    transition: background 0.2s ease;
  }
  .btn-ai-fill:hover { background: color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .btn-ai-fill:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ===== Search Dropdown ===== */
  .search-field-wrap { position: relative; }
  .search-results {
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--color-base-200);
    border: 2px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: 10px; margin-top: 6px;
    max-height: 360px; overflow-y: auto; z-index: 10;
    box-shadow: 0 8px 30px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,0,0,0.3); display: none;
  }
  .search-results.show { display: block; }
  .search-result-item {
    display: flex; gap: 12px; padding: 14px;
    cursor: pointer; transition: background 0.15s;
    border-bottom: 1px solid color-mix(in srgb, var(--color-base-content) 8%, transparent);
    align-items: flex-start;
  }
  .search-result-item:last-child { border-bottom: none; }
  .search-result-item:hover { background: color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .sr-thumb { width: 48px; height: 68px; border-radius: 6px; object-fit: cover; flex-shrink: 0; background: color-mix(in srgb, var(--color-primary) 5%, transparent); }
  .sr-info { flex: 1; min-width: 0; }
  .sr-title { font-size: 0.92rem; font-weight: 600; margin-bottom: 4px; }
  .sr-meta { font-size: 0.78rem; opacity: 0.6; }
  .sr-meta span { margin-right: 8px; }
  .sr-episodes { color: var(--color-warning, #f0a000); font-weight: 600; }
  .sr-source { font-size: 0.7rem; color: var(--color-secondary); }

  /* ===== Source Compare ===== */
  .source-compare { margin-top: 12px; padding: 12px; border-radius: var(--radius-selector, 0.25rem); background: color-mix(in srgb, var(--color-primary) 2%, transparent); border: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent); }
  .source-compare-title { font-size: 0.8rem; font-weight: 600; opacity: 0.7; margin-bottom: 8px; }
  .source-option {
    display: flex; align-items: center; gap: 10px; padding: 8px 10px;
    border-radius: var(--radius-selector, 0.25rem); cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent); margin-bottom: 6px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .source-option:hover { border-color: color-mix(in srgb, var(--color-primary) 20%, transparent); }
  .source-option.chosen { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 4%, transparent); }
  .source-option input[type="radio"] { accent-color: var(--color-primary); }
  .source-option .so-info { flex: 1; font-size: 0.82rem; }
  .source-option .so-episodes { font-weight: 700; color: var(--color-warning, #f0a000); }

  .spinner {
    display: inline-block; width: 14px; height: 14px;
    border: 2px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-top-color: var(--color-primary); border-radius: 50%;
    animation: spin 0.6s linear infinite;
    vertical-align: middle; margin-right: 6px;
  }

  .modal-cover-preview {
    width: 100%; border-radius: var(--radius-selector, 0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 8%, transparent);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; margin-top: 8px; background: color-mix(in srgb, var(--color-primary) 2%, transparent);
  }
  .modal-cover-preview img { width: 100%; height: auto; object-fit: contain; display: block; }
  .modal-cover-preview .placeholder { opacity: 0.5; font-size: 0.85rem; }
  .cover-options { display: flex; gap: 8px; margin-top: 8px; overflow-x: auto; padding-bottom: 4px; }
  .cover-option {
    width: 60px; height: 85px; border-radius: var(--radius-selector, 0.25rem);
    border: 2px solid color-mix(in srgb, var(--color-primary) 8%, transparent); cursor: pointer;
    overflow: hidden; flex-shrink: 0;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    background: color-mix(in srgb, var(--color-primary) 3%, transparent);
  }
  .cover-option:hover { border-color: color-mix(in srgb, var(--color-base-content) 30%, transparent); }
  .cover-option.selected { border-color: var(--color-primary); box-shadow: 0 0 10px color-mix(in srgb, var(--color-primary) 30%, transparent); }
  .cover-option img { width: 100%; height: 100%; object-fit: cover; }
  .cover-option-src { font-size: 0.6rem; opacity: 0.5; text-align: center; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 60px; }

  /* ===== Toast ===== */
  .toast-container { position: fixed; bottom: 32px; right: 32px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
  .toast {
    background: var(--color-base-200);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border: 1px solid color-mix(in srgb, var(--color-primary) 6%, transparent);
    border-radius: 6px; padding: 12px 20px;
    color: var(--color-base-content); font-size: 0.9rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    animation: toastIn 0.3s ease, toastOut 0.3s ease 3.5s forwards;
    max-width: 420px;
    display: flex; align-items: center; gap: 8px;
  }
  .toast-undo {
    margin-left: 10px; padding: 3px 10px; border-radius: 4px;
    border: 1px solid var(--color-primary); background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary); cursor: pointer; font-size: 0.78rem; font-weight: 600;
    font-family: inherit; white-space: nowrap; flex-shrink: 0;
    transition: background 0.15s ease;
  }
  .toast-undo:hover { background: color-mix(in srgb, var(--color-primary) 20%, transparent); }

  .empty-state { text-align: center; padding: 80px 20px; opacity: 0.5; grid-column: 1 / -1; }
  .empty-state .empty-icon { font-size: 3.5rem; margin-bottom: 16px; }
  .empty-state p { font-size: 0.95rem; }

  /* ===== Theme Popover ===== */
  .theme-popover {
    position: fixed; z-index: 300;
    background: var(--color-base-100);
    border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
    border-radius: var(--radius-box, 0.5rem);
    padding: 8px; width: 280px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    display: none;
  }
  .theme-popover.show { display: block; animation: popupIn 0.2s cubic-bezier(0.16,1,0.3,1); }
  .theme-popover-backdrop { position: fixed; inset: 0; z-index: 299; display: none; }
  .theme-popover-backdrop.show { display: block; }
  .theme-option {
    display: flex; align-items: center; gap: 12px;
    width: 100%; padding: 10px 12px; border: none;
    background: transparent; color: var(--color-base-content);
    cursor: pointer; font-family: inherit; font-size: 0.85rem;
    border-radius: var(--radius-selector, 0.25rem);
    transition: background 0.15s ease; text-align: left;
  }
  .theme-option:hover { background: color-mix(in srgb, var(--color-primary) 5%, transparent); }
  .theme-option.active { background: color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .theme-option-icon { font-size: 1.2rem; width: 28px; text-align: center; flex-shrink: 0; }
  .theme-option-info { flex: 1; }
  .theme-option-name { font-weight: 600; }
  .theme-option-desc { font-size: 0.7rem; opacity: 0.5; }
  .theme-option-check { color: var(--color-primary); font-weight: 700; display: none; }
  .theme-option.active .theme-option-check { display: block; }

  /* ===== Settings Modal ===== */
  .settings-section { margin-bottom: 20px; }
  .settings-section h3 { font-size: 0.9rem; font-weight: 600; opacity: 0.7; margin-bottom: 10px; letter-spacing: 0.04em; }

  /* ===== Keyframes ===== */
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes cardIn { from { opacity: 0; transform: translateY(20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes popupIn { from { opacity: 0; transform: scale(0.92) translateY(-8px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  @keyframes toastIn { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes toastOut { from { opacity: 1; } to { opacity: 0; transform: translateY(-10px); } }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .sidebar {
      left: 12px; top: 12px;
      transform: translateX(calc(-100% - 36px));
      width: var(--sidebar-w) !important; min-width: var(--sidebar-w) !important;
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99; }
    .sidebar-overlay.show { display: block; }
    .main { margin-left: 0 !important; }
    .hamburger { display: block; }
    .topbar { padding: 0 12px; gap: 8px; }
    .content { padding: 20px 16px 32px; }
    .card-grid { grid-template-columns: repeat(auto-fill, 160px); justify-content: center; gap: 14px; }
    .stats-row { gap: 10px; }
    .stat-item { padding: 14px 16px; min-width: 100px; }
    .stat-icon { width: 36px; height: 36px; font-size: 1rem; }
    .stat-num { font-size: 1.3rem; }
    .toast-container { bottom: 16px; right: 16px; left: 16px; }
    .toast { max-width: 100%; }
    .detail-popup { width: 300px; max-height: 65vh; }
  }
  @media (max-width: 480px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .card-body { padding: 10px; }
    .card-title { font-size: 0.85rem; }
    .episode-grid { grid-template-columns: repeat(auto-fill, minmax(38px, 1fr)); gap: 6px; }
    .episode-block { font-size: 0.75rem; }
    .edit-modal-box { padding: 20px; }
  }
</style>
</head>
<body>

<div class="app">
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <aside class="sidebar bg-base-100 border-r border-primary/5" id="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo text-primary"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 20 2 20"/><line x1="12" y1="8" x2="12" y2="14"/><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/></svg></div>
      <span class="sidebar-brand-text text-base-content">追番管理器</span>
    </div>
    <nav class="sidebar-nav">
      <button class="nav-item active" data-filter="all" onclick="setFilter('all')">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></span><span class="nav-label">全部番剧</span>
        <span class="nav-badge" id="badgeAll">0</span>
      </button>
      <button class="nav-item" data-filter="towatch" onclick="setFilter('towatch')">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/></svg></span><span class="nav-label">待看</span>
        <span class="nav-badge" id="badgeTowatch">0</span>
      </button>
      <button class="nav-item" data-filter="watching" onclick="setFilter('watching')">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><polygon points="5 2 21 12 5 22"/><line x1="5" y1="2" x2="5" y2="22"/></svg></span><span class="nav-label">正在看</span>
        <span class="nav-badge" id="badgeWatching">0</span>
      </button>
      <button class="nav-item" data-filter="watched" onclick="setFilter('watched')">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter"><polygon points="12 2 22 12 12 22 2 12"/><polyline points="17 9 11 15 8 12"/></svg></span><span class="nav-label">已看完</span>
        <span class="nav-badge" id="badgeWatched">0</span>
      </button>

      <div class="nav-section-header">
        <span class="nav-section-geo-decor bg-primary"></span>
        <span class="nav-section-glow-label text-base-content opacity-50">动漫</span>
        <span class="nav-section-energy-line bg-primary/20"></span>
      </div>
      <button class="nav-item nav-sub" data-cat="chinese_anime" onclick="setCategoryFilter('chinese_anime')" id="navCatChineseAnime">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">国漫</span><span class="nav-badge" id="badgeChineseAnime">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="japanese_anime" onclick="setCategoryFilter('japanese_anime')" id="navCatJapaneseAnime">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">日漫 / 番剧</span><span class="nav-badge" id="badgeJapaneseAnime">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="theatrical_anime" onclick="setCategoryFilter('theatrical_anime')" id="navCatTheatricalAnime">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">剧场版动画</span><span class="nav-badge" id="badgeTheatricalAnime">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="anime_movie" onclick="setCategoryFilter('anime_movie')" id="navCatAnimeMovie">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">动画电影</span><span class="nav-badge" id="badgeAnimeMovie">0</span>
      </button>

      <div class="nav-section-header">
        <span class="nav-section-geo-decor bg-primary"></span>
        <span class="nav-section-glow-label text-base-content opacity-50">影视剧</span>
        <span class="nav-section-energy-line bg-primary/20"></span>
      </div>
      <button class="nav-item nav-sub" data-cat="movie" onclick="setCategoryFilter('movie')" id="navCatMovie">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">电影</span><span class="nav-badge" id="badgeMovie">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="tv_drama" onclick="setCategoryFilter('tv_drama')" id="navCatTvDrama">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">电视剧</span><span class="nav-badge" id="badgeTvDrama">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="web_drama" onclick="setCategoryFilter('web_drama')" id="navCatWebDrama">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">网剧</span><span class="nav-badge" id="badgeWebDrama">0</span>
      </button>
      <button class="nav-item nav-sub" data-cat="documentary" onclick="setCategoryFilter('documentary')" id="navCatDocumentary">
        <span class="nav-energy-bar"></span><span class="nav-glow-dot"></span>
        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12,2 20,12 12,22 4,12"/></svg></span><span class="nav-label">纪录片</span><span class="nav-badge" id="badgeDocumentary">0</span>
      </button>
    </nav>

    <div class="sidebar-section">
      <div class="sidebar-section-title">
        <span>收藏夹</span>
        <span style="cursor:pointer;color:var(--color-primary);font-size:0.78rem" onclick="openFolderModal()" title="新建收藏夹">＋</span>
      </div>
      <div id="sidebarFolders"></div>
    </div>
    <button class="sidebar-collapsed-btn" onclick="openFolderModal()" title="新建收藏夹">＋</button>

    <div class="sidebar-section">
      <button class="src-add-btn" onclick="openSourceManager()" style="width:100%">🔍 管理搜索来源</button>
    </div>
    <button class="sidebar-collapsed-btn" onclick="openSourceManager()" title="搜索来源">🔍</button>

    <button class="sidebar-toggle" onclick="toggleSidebar()" title="收起侧边栏"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="15 5 8 12 15 19"/></svg></button>
  </aside>

  <main class="main">
    <div class="topbar">
      <button class="hamburger btn btn-ghost btn-sm text-base-content" onclick="openSidebar()" aria-label="菜单">☰</button>
      <div class="search-wrap" id="searchWrap">
        <input type="text" class="search-input" id="searchInput" placeholder="搜索番剧名称..." oninput="renderCards()" onfocus="showSearchHistory()" onkeydown="if(event.key==='Enter')saveSearchTerm()" autocomplete="off">
        <div class="search-history-dropdown" id="searchHistoryDropdown"></div>
      </div>
      <div class="backend-status offline" id="backendStatus" onclick="checkBackend()" title="点击重新检测后端">
        <span class="bdot"></span>
        <span id="backendLabel">后端未连接</span>
      </div>
      <button class="backend-status" id="btnTheme" onclick="toggleThemePopover()" title="切换主题风格" style="margin-right:0;font-size:1.1rem;padding:6px 10px">🎨</button>
      <button class="backend-status" id="btnSettings" onclick="openSettingsModal()" title="设置" style="margin-right:0;font-size:1.1rem;padding:6px 10px">⚙</button>
      <button class="btn-add" onclick="openAddModal()">＋ 添加番剧</button>
      <button class="btn-add" onclick="openBatchAddModal()" title="批量添加，一行一个名字">📋 批量添加</button>
      <button class="btn-add" id="btnBatchAi" onclick="batchAiFillAll()" title="一键AI补全：自动为缺失简介的番剧填充信息" style="background:color-mix(in srgb, var(--color-secondary) 15%, transparent);border-color:var(--color-secondary)">🤖 一键AI补全</button>
      <button class="btn-add" id="btnReclassify" onclick="reclassifyAll()" title="重新分类：根据分类标准重新识别所有番剧的分类" style="background:color-mix(in srgb, var(--color-accent) 12%, transparent);border-color:var(--color-accent)">🔄 重新分类</button>
    </div>

    <div class="content">
      <div class="stats-row">
        <div class="stat-item" id="statBtnTowatch" onclick="setStatusFilter('towatch')"><div class="stat-icon towatch">📋</div><div class="stat-info"><div class="stat-num" id="statTowatch">0</div><div class="stat-label">待看</div></div></div>
        <div class="stat-item" id="statBtnWatching" onclick="setStatusFilter('watching')"><div class="stat-icon watching">▶️</div><div class="stat-info"><div class="stat-num" id="statWatching">0</div><div class="stat-label">正在看</div></div></div>
        <div class="stat-item" id="statBtnWatched" onclick="setStatusFilter('watched')"><div class="stat-icon watched">✅</div><div class="stat-info"><div class="stat-num" id="statWatched">0</div><div class="stat-label">已看完</div></div></div>
      </div>
      <div class="sort-bar">
        <span class="sort-label">排序</span>
        <select class="sort-select" id="sortBy" onchange="applySort()">
          <option value="">默认</option>
          <option value="score">评分</option>
          <option value="totalEpisodes">总集数</option>
        </select>
        <button class="sort-order-btn" id="sortOrderBtn" onclick="toggleSortOrder()" title="切换排序方向">↓</button>
        <button class="sort-order-btn" id="btnSelectMode" onclick="toggleSelectionMode()" title="批量选择">☑</button>
      </div>
      <div class="batch-bar" id="batchBar" style="display:none">
        <span class="count" id="batchCount">已选 0 项</span>
        <select id="batchMoveCategory" onchange="batchMoveCategory(this.value);this.value=''" style="margin-left:auto">
          <option value="">移至分类…</option>
          <optgroup label="动漫">
            <option value="chinese_anime">国漫</option>
            <option value="japanese_anime">日漫 / 番剧</option>
            <option value="theatrical_anime">剧场版动画</option>
            <option value="anime_movie">动画电影</option>
          </optgroup>
          <optgroup label="影视剧">
            <option value="movie">电影</option>
            <option value="tv_drama">电视剧</option>
            <option value="web_drama">网剧</option>
            <option value="documentary">纪录片</option>
          </optgroup>
        </select>
        <select id="batchMoveFolder" onchange="batchMoveFolder(this.value);this.value=''">
          <option value="">移至收藏夹…</option>
        </select>
        <select id="batchStatus" onchange="batchSetStatus(this.value);this.value=''">
          <option value="">更改状态…</option>
          <option value="towatch">待看</option>
          <option value="watching">正在看</option>
          <option value="watched">已看完</option>
        </select>
        <button class="batch-action-btn" onclick="selectAllCards()">全选</button>
        <button class="batch-action-btn" onclick="deselectAllCards()">取消全选</button>
        <button class="batch-action-btn danger" onclick="batchDelete()">🗑 批量删除</button>
      </div>
      <div class="card-grid" id="cardGrid"></div>
    </div>
  </main>
</div>

<!-- ===== Add/Edit Anime Modal ===== -->
<div class="modal-overlay" id="modalOverlay" style="display:none">
  <div class="edit-modal-box">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h2 id="modalTitle" style="margin-bottom:0">添加番剧</h2>
      <div style="display:flex;gap:8px">
        <button class="btn-cancel" onclick="closeModal()">取消</button>
        <button class="btn-save" id="btnSave" onclick="saveAnime()">添加</button>
      </div>
    </div>
    <div class="modal-note" id="modalNote">
      💡 输入番剧名称后将通过后端搜索已启用的来源并自动填充信息。<br>
      也可以粘贴番剧链接（每行一个），系统会自动抓取解析。
    </div>

    <div class="modal-field search-field-wrap">
      <label>番剧名称 *</label>
      <div style="display:flex;gap:8px">
        <input type="text" id="mTitle" placeholder="输入番剧名称..." maxlength="100" oninput="onTitleInput()" style="flex:1">
        <button class="btn-ai-fill" id="btnAiFill" onclick="aiFillInfo()" title="使用 DeepSeek AI 智能填充">🤖 AI 填充</button>
      </div>
      <div class="search-results" id="searchResults"></div>
    </div>

    <div class="modal-field">
      <label>🔗 参考链接（每行一个）</label>
      <textarea id="mLinks" placeholder="https://bgm.tv/subject/12345&#10;https://m.agedongman.net/video/12345" rows="2" onchange="onLinksChange()"></textarea>
      <div id="sourceCompare"></div>
    </div>

    <div class="modal-field-row">
      <div class="modal-field">
        <label>状态</label>
        <select id="mStatus">
          <option value="towatch">待看</option>
          <option value="watching">正在看</option>
          <option value="watched">已看完</option>
        </select>
      </div>
      <div class="modal-field">
        <label>分类</label>
        <select id="mCategory">
          <option value="">未分类</option>
          <optgroup label="动漫">
            <option value="chinese_anime">国漫</option>
            <option value="japanese_anime">日漫 / 番剧</option>
            <option value="theatrical_anime">剧场版动画</option>
            <option value="anime_movie">动画电影</option>
          </optgroup>
          <optgroup label="影视剧">
            <option value="movie">电影</option>
            <option value="tv_drama">电视剧</option>
            <option value="web_drama">网剧</option>
            <option value="documentary">纪录片</option>
          </optgroup>
        </select>
      </div>
    </div>
    <div class="modal-field-row">
      <div class="modal-field">
        <label>总集数 <span id="epSourceTag" style="font-size:0.7rem;opacity:0.5"></span></label>
        <input type="number" id="mTotalEp" value="12" min="1" max="999">
      </div>
      <div class="modal-field">
        <label>收藏夹</label>
        <select id="mFolder">
          <option value="">无</option>
        </select>
      </div>
    </div>

    <div class="modal-field">
      <label>剧情简介</label>
      <textarea id="mSynopsis" placeholder="番剧简介..." rows="3"></textarea>
    </div>

    <div class="modal-field-row">
      <div class="modal-field">
        <label>评分 (1-10)</label>
        <input type="number" id="mScore" placeholder="可选" min="0" max="10" step="0.5">
      </div>
      <div class="modal-field">
        <label>封面图片URL</label>
        <input type="text" id="mCover" placeholder="可选，留空自动生成">
      </div>
    </div>

    <div class="modal-field">
      <label>📁 上传封面图片</label>
      <input type="file" id="mCoverFile" accept="image/*" onchange="previewCoverFile()">
      <div class="modal-cover-preview" id="coverPreview"><span class="placeholder">预览</span></div>
    </div>

    <div id="coverPicker" style="display:none">
      <label style="font-size:0.82rem;font-weight:500;opacity:0.7;margin-bottom:6px;display:block">🖼 选择封面（点击切换）</label>
      <div class="cover-options" id="coverOptions"></div>
    </div>

    <div style="margin-top:20px;padding-top:16px;border-top:1px solid color-mix(in srgb, var(--color-primary) 6%, transparent)">
      <button class="btn-cancel" id="btnDeleteInModal" style="display:none;color:var(--color-error);border-color:color-mix(in srgb, var(--color-error) 30%, transparent);width:100%" onclick="requestDeleteAnime()">🗑 删除此条目</button>
    </div>
  </div>
</div>

<!-- ===== Delete Confirm Modal ===== -->
<div class="modal-overlay" id="deleteConfirmOverlay" style="display:none">
  <div class="edit-modal-box small">
    <h2>确认删除</h2>
    <div style="text-align:center;padding:16px 0">
      <p style="font-size:1rem" id="deleteConfirmTitle"></p>
      <p style="font-size:0.8rem;opacity:0.5;margin-top:6px">此操作不可撤销，进度和记录将被永久删除</p>
    </div>
    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeDeleteConfirm()">取消</button>
      <button class="btn-save" style="background:var(--color-error);border-color:var(--color-error);color:var(--color-error-content)" id="btnConfirmDelete">确认删除</button>
    </div>
  </div>
</div>

<!-- ===== Batch Add Modal ===== -->
<div class="modal-overlay" id="batchAddOverlay" style="display:none">
  <div class="edit-modal-box small">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h2 style="margin-bottom:0">📋 批量添加番剧</h2>
      <div style="display:flex;gap:8px">
        <button class="btn-cancel" onclick="closeBatchAddModal()">取消</button>
        <button class="btn-save" id="btnBatchAdd" onclick="batchAddAnime()">批量添加</button>
      </div>
    </div>
    <div class="modal-note" id="batchAddNote">
      一行一个番剧名称，将统一添加到<span id="batchAddTargetCat" style="font-weight:600">待看</span>分类下。
    </div>
    <div class="modal-field">
      <textarea id="batchAddNames" placeholder="进击的巨人&#10;命运石之门&#10;鬼灭之刃&#10;..." rows="10" style="font-family:inherit;resize:vertical"></textarea>
    </div>
    <div style="margin-top:4px;font-size:0.75rem;opacity:0.5" id="batchAddCount">共 0 个番剧</div>
  </div>
</div>

<!-- ===== Add Source Modal ===== -->
<div class="modal-overlay" id="sourceModalOverlay" style="display:none;z-index:210">
  <div class="edit-modal-box small">
    <h2 id="sourceModalTitle">添加搜索来源</h2>
    <div class="modal-note">
      输入番剧网站的搜索链接模板，用 <code>{query}</code> 代替搜索关键词的位置。<br>
      例如：<code>https://example.com/search?keyword={query}</code>
    </div>
    <div class="modal-field">
      <label>来源名称</label>
      <input type="text" id="srcName" placeholder="例如：age动漫" maxlength="50">
    </div>
    <div class="modal-field">
      <label>搜索链接模板</label>
      <input type="text" id="srcUrl" placeholder="https://m.agedongman.net/search?q={query}" maxlength="500">
    </div>
    <div class="modal-field">
      <button class="btn-cancel" onclick="testSourceUrl()" style="width:100%;text-align:center">🔗 测试连接</button>
    </div>
